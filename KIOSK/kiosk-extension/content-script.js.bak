(function () {
  console.log('[Kiosk Monitor Extension] Initialized on page:', window.location.href);

  let alreadyNotified = false;

  // Persist kioskCallbackUrl across multi-step wizard pages on Ministry portals
  try {
    const initParams = new URLSearchParams(window.location.search);
    const cbUrl = initParams.get('kioskCallbackUrl');
    if (cbUrl) {
      sessionStorage.setItem('KIOSK_CALLBACK_URL', decodeURIComponent(cbUrl));
    }
  } catch (e) {}

  // Official Ministry Codes & Titles mapping for ALL Ministries
  function detectMinistryInfo() {
    const host = window.location.hostname.toLowerCase();
    const bodyText = document.body ? document.body.innerText : '';
    const urlStr = window.location.href.toLowerCase();

    // 1. Special Systems
    if (host.includes('dangkykinhdoanh') || bodyText.includes('Đăng ký Hộ kinh doanh') || urlStr.includes('giaydenhidangkyhkd')) {
      return { code: 'G05', title: 'Hệ thống Đăng ký Hộ kinh doanh' };
    }
    
    // 2. 7 VNPT-developed Ministries
    if (host.includes('moh.gov.vn')) return { code: 'G18', title: 'Bộ Y tế' };
    if (host.includes('moit.gov.vn')) return { code: 'G02', title: 'Bộ Công Thương' };
    if (host.includes('moet.gov.vn')) return { code: 'G03', title: 'Bộ Giáo dục và Đào tạo' };
    if (host.includes('most.gov.vn') || host.includes('mst.gov.vn')) return { code: 'G06', title: 'Bộ Khoa học và Công nghệ' };
    if (host.includes('moha.gov.vn') || host.includes('mohome.gov.vn')) return { code: 'G09', title: 'Bộ Nội vụ' };
    if (host.includes('mae.gov.vn') || host.includes('mard.gov.vn') || host.includes('monre.gov.vn')) return { code: 'G10', title: 'Bộ Nông nghiệp và Môi trường' };
    if (host.includes('moc.gov.vn')) return { code: 'G17', title: 'Bộ Xây dựng' };

    // 3. Other Ministries & Central Agencies
    if (host.includes('mps.gov.vn') || host.includes('bocongan.gov.vn')) return { code: 'G01', title: 'Bộ Công an' };
    if (host.includes('mofa.gov.vn')) return { code: 'G08', title: 'Bộ Ngoại giao' };
    if (host.includes('mod.gov.vn')) return { code: 'G11', title: 'Bộ Quốc phòng' };
    if (host.includes('mof.gov.vn')) return { code: 'G12', title: 'Bộ Tài chính' };
    if (host.includes('moj.gov.vn') || host.includes('vnptigate.vn')) return { code: 'G15', title: 'Bộ Tư pháp' };
    if (host.includes('bvhttdl.gov.vn')) return { code: 'G16', title: 'Bộ Văn hoá, Thể thao và Du lịch' };
    if (host.includes('sbv.gov.vn')) return { code: 'G19', title: 'Ngân hàng Nhà nước Việt Nam' };
    if (host.includes('thanhtra.gov.vn')) return { code: 'G20', title: 'Thanh tra Chính phủ' };
    if (host.includes('cema.gov.vn')) return { code: 'G21', title: 'Ủy ban Dân tộc' };
    if (host.includes('vpcp.gov.vn')) return { code: 'G22', title: 'Văn phòng Chính phủ' };
    if (host.includes('vov.vn')) return { code: 'G27', title: 'Đài Tiếng nói Việt Nam' };
    if (host.includes('vtv.vn')) return { code: 'G28', title: 'Đài Truyền hình Việt Nam' };
    if (host.includes('vnanet.vn')) return { code: 'G30', title: 'Thông tấn xã Việt Nam' };
    if (host.includes('vast.gov.vn')) return { code: 'G31', title: 'Viện Hàn lâm Khoa học và Công nghệ Việt Nam' };
    if (host.includes('vass.gov.vn')) return { code: 'G32', title: 'Viện Hàn lâm Khoa học xã hội Việt Nam' };
    if (host.includes('atgt.gov.vn')) return { code: 'G35', title: 'Ủy ban An toàn giao thông Quốc gia' };

    // Fallback parsing from URL params or Page Title
    const urlParams = new URLSearchParams(window.location.search);
    const codeFromUrl = urlParams.get('ministryCode') || urlParams.get('boCode') || '';
    const titleFromUrl = urlParams.get('ministryTitle') || urlParams.get('boTitle') || urlParams.get('boName') || '';

    const fallbackTitle = titleFromUrl || (document.title ? document.title.split('-')[0].trim() : 'Cơ quan tiếp nhận');
    return {
      code: codeFromUrl || 'BN',
      title: fallbackTitle
    };
  }

  function scanDossierCode() {
    try {
      if (alreadyNotified) {
        return;
      }

      const urlParams = new URLSearchParams(window.location.search);
      const urlStr = window.location.href.toLowerCase();
      const bodyText = document.body ? document.body.innerText : '';

      // Check if page indicates submission / payment success / acceptance
      const isSuccessPage =
        urlStr.includes('thanh-toan-thanh-cong') ||
        urlStr.includes('nhat-ky-nop') ||
        urlStr.includes('success') ||
        urlStr.includes('thanh-cong') ||
        urlStr.includes('complete') ||
        urlStr.includes('documentedit.aspx') ||
        bodyText.includes('Gửi hồ sơ thành công') ||
        bodyText.includes('Nộp hồ sơ thành công') ||
        bodyText.includes('Tiếp nhận hồ sơ thành công') ||
        bodyText.includes('đã được gửi thành công') ||
        bodyText.includes('nộp thành công') ||
        bodyText.includes('Thông tin hồ sơ đã được chấp nhận') ||
        bodyText.includes('hồ sơ đã được chấp nhận');

      if (!isSuccessPage) {
        return;
      }

      let maSoHoSo = '';

      // 1. Check URL query parameters (standard keys)
      const possibleParamKeys = ['masohoso', 'dossiercode', 'mahoso', 'code', 'sohoso', 'ma_ho_so', 'mshs'];
      for (const key of possibleParamKeys) {
        for (const [pKey, pVal] of urlParams.entries()) {
          if (pKey.toLowerCase() === key && pVal && pVal.length >= 6) {
            maSoHoSo = pVal.trim();
            break;
          }
        }
        if (maSoHoSo) break;
      }

      // 2. Scan DOM text via Regex patterns
      if (!maSoHoSo && bodyText) {
        const regexes = [
          /Mã\s*(?:số)?\s*hồ\s*sơ\s*[:\s]+([A-Z0-9.\-_]{6,40})/i,
          /Mã\s*biên\s*nhận\s*[:\s]+([A-Z0-9.\-_]{6,40})/i,
          /Mã\s*tra\s*cứu\s*[:\s]+([A-Z0-9.\-_]{6,40})/i,
          /Số\s*hồ\s*sơ\s*[:\s]+([A-Z0-9.\-_]{6,40})/i
        ];

        for (const regex of regexes) {
          const match = bodyText.match(regex);
          if (match && match[1]) {
            maSoHoSo = match[1].trim();
            break;
          }
        }
      }

      // 3. Fallback for systems without explicit "Số hồ sơ" (e.g. Đăng ký hộ kinh doanh with ?h=315)
      if (!maSoHoSo && isSuccessPage) {
        if (urlParams.get('h')) {
          maSoHoSo = 'HKD-' + urlParams.get('h');
        } else if (urlParams.get('id')) {
          maSoHoSo = 'ID-' + urlParams.get('id');
        } else {
          maSoHoSo = 'ĐÃ TIẾP NHẬN';
        }
      }

      if (isSuccessPage) {
        const storageKey = 'KIOSK_NOTIFIED_' + (maSoHoSo || window.location.pathname);
        if (sessionStorage.getItem(storageKey) === 'true') {
          alreadyNotified = true;
          return;
        }

        alreadyNotified = true;
        sessionStorage.setItem(storageKey, 'true');

        console.log('[Kiosk Monitor Extension] Detected Submission Success:', maSoHoSo);

        const ministryInfo = detectMinistryInfo();
        const cleanMaSoHoSo = (maSoHoSo !== 'ĐÃ TIẾP NHẬN') ? maSoHoSo : '';
        const messageData = {
          type: 'KIOSK_MINISTRY_DOSSIER_SUBMITTED',
          maSoHoSo: cleanMaSoHoSo,
          ministryCode: ministryInfo.code,
          boCode: ministryInfo.code,
          boName: ministryInfo.title,
          ministryTitle: ministryInfo.title
        };

        // 1. Post message to C# WebView2 host (WinForms)
        if (window.chrome && window.chrome.webview) {
          window.chrome.webview.postMessage(messageData);
        }

        // 2. Post message to parent / opener window (Browser popup mode)
        if (window.opener && !window.opener.closed) {
          window.opener.postMessage(messageData, '*');
        }
        window.postMessage(messageData, '*');

        // 3. DIRECT BROWSER REDIRECT (Dành cho Web thông thường trên Chrome/Edge)
        // Nếu không có host C# WinForms điều hướng thì Extension sẽ tự chuyển hướng tab
        if (!window.chrome || !window.chrome.webview) {
          try {
            let callbackUrl = sessionStorage.getItem('KIOSK_CALLBACK_URL') || urlParams.get('kioskCallbackUrl');
            
            if (!callbackUrl) {
              // Mặc định chuyển về trang callback của Kiosk local
              callbackUrl = 'https://kiosk.quangtri.gov.vn/kiosk/callback';
            }

            const separator = callbackUrl.includes('?') ? '&' : '?';
            const finalRedirectUrl = `${callbackUrl}${separator}maSoHoSo=${encodeURIComponent(cleanMaSoHoSo)}&ministryCode=${encodeURIComponent(ministryInfo.code)}&ministryTitle=${encodeURIComponent(ministryInfo.title)}`;
            
            console.log('[Kiosk Monitor Extension] >>> BROWSER REDIRECTING TO:', finalRedirectUrl);
            setTimeout(function () {
              window.location.href = finalRedirectUrl;
            }, 1200);
          } catch (redirErr) {
            console.warn('[Kiosk Monitor Extension] Redirect error:', redirErr);
          }
        }
      }
    } catch (err) {
      console.warn('[Kiosk Monitor Extension] Scan error:', err);
    }
  }

  // Initial scan after DOM load
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setTimeout(scanDossierCode, 1000);
  } else {
    document.addEventListener('DOMContentLoaded', () => setTimeout(scanDossierCode, 1000));
  }

  // Periodic scan for Single Page Apps (SPA) or dynamic updates
  setInterval(scanDossierCode, 2500);
})();
